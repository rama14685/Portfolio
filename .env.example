# ====================================================
# SUPABASE CONFIGURATION FOR RETRO PIXEL PORTFOLIO
# Copas file ini menjadi `.env` lalu masukkan URL & anon key Supabase kamu.
# Jika belum diisi, aplikasi akan menggunakan Mock Data otomatis.
# ====================================================

VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
